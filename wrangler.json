{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "math",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "plusi.app", "custom_domain": true },
    { "pattern": "www.plusi.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/audio/*"]
  },
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "plusi-audio" }],
  "durable_objects": {
    "bindings": [
      { "name": "FAMILY", "class_name": "Family" },
      { "name": "PAIRING", "class_name": "Pairing" },
      { "name": "ACCOUNTS", "class_name": "Accounts" },
      { "name": "STATS", "class_name": "Stats" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Family", "Pairing"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts", "Stats"] }
  ]
}
