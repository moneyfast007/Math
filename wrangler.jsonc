{
  // Cloudflare Workers static assets: serves the built SPA from ./dist.
  // `public/_headers` (CSP and cache rules) is copied into dist by Vite and honored here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "math",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths (e.g. /install, /playground) return index.html so the client router handles them.
    "not_found_handling": "single-page-application"
  }
}
